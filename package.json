{
  "name": "ai-codebase-mapper",
  "displayName": "AI Codebase Mapper",
  "description": "AI-powered interactive architecture map of your codebase. Understand unfamiliar projects instantly.",
  "version": "0.1.0",
  "publisher": "ai-codebase-mapper",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Machine Learning"
  ],
  "keywords": [
    "architecture",
    "codebase",
    "ai",
    "dependency",
    "graph",
    "mapper"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCodebaseMapper.analyzeProject",
        "title": "Analyze Project",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.openMap",
        "title": "Open Architecture Map",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.refreshAnalysis",
        "title": "Refresh Analysis",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.explainCurrentFile",
        "title": "Explain Current File",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.showDependencies",
        "title": "Show Dependencies",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.showDependents",
        "title": "Show Dependents",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.askAI",
        "title": "Ask AI About Project",
        "category": "AI Codebase Mapper"
      },
      {
        "command": "aiCodebaseMapper.clearCache",
        "title": "Clear Project Cache",
        "category": "AI Codebase Mapper"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "aiCodebaseMapper.explainCurrentFile",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "aiCodebaseMapper.explainCurrentFile",
          "when": "editorTextFocus",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "AI Codebase Mapper",
      "properties": {
        "aiCodebaseMapper.provider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "compatible"],
          "description": "AI provider to use (OpenAI or OpenAI-compatible endpoint)"
        },
        "aiCodebaseMapper.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name to use for analysis"
        },
        "aiCodebaseMapper.apiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for the AI API (useful for compatible providers)"
        },
        "aiCodebaseMapper.sendSourceCode": {
          "type": "boolean",
          "default": true,
          "description": "Whether to send source code snippets to the AI. If false, only metadata and dependencies are sent."
        },
        "aiCodebaseMapper.maxFileSize": {
          "type": "number",
          "default": 100000,
          "description": "Maximum file size (bytes) to include in analysis"
        },
        "aiCodebaseMapper.excludePatterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional glob patterns to exclude from scanning"
        },
        "aiCodebaseMapper.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Automatically analyze the project when a workspace is opened"
        },
        "aiCodebaseMapper.maxFilesForAI": {
          "type": "number",
          "default": 150,
          "description": "Maximum number of files to include in AI context"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "ignore": "^5.3.0"
  }
}
